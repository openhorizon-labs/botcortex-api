# Supabase Postgres — use the POOLER connection string (transaction mode):
# Supabase dashboard → Project Settings → Database → Connection string → URI (pooler)
# Local dev without credentials:
# DATABASE_URL=pglite://memory
DATABASE_URL=postgresql://postgres.ngsxhtctojppqmwhnbbo:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# openssl rand -hex 32
BETTER_AUTH_SECRET=

# Where this api is reachable (callbacks/redirects derive from it)
BETTER_AUTH_URL=http://localhost:8787

# Comma-separated app origins allowed to hit auth cross-origin
TRUSTED_ORIGINS=http://localhost:3000

PORT=8787

# Vendor keys for the inference proxy (/v1/chat/completions, /v1/messages).
# These are OURS — robots authenticate with a bx_live_ key instead and never
# see these. Set both in Vercel; a missing one 503s that provider's route.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Where pairing is approved — the WEB app, not this service. The device flow's
# verification_uri is built from it, so a wrong value sends robots' owners to
# a page that doesn't exist.
APP_URL=http://localhost:3000

# Point the proxy at a stub instead of a vendor (tests, local development).
# Unset in production — the defaults are the real endpoints.
# OPENAI_UPSTREAM_URL=
# ANTHROPIC_UPSTREAM_URL=

# Encrypts owners' own model keys at rest (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# If unset, a key is derived from BETTER_AUTH_SECRET — which works, but means
# rotating the auth secret orphans every stored key. Set this one in production.
BYOK_ENCRYPTION_KEY=
